# תבנית משתני סביבה - העתיקו לקובץ .env (לא נעקב ב-git, ראו .gitignore) ומלאו
# ערכים אמיתיים. השרת נכשל מיד עם הודעה ברורה אם ANTHROPIC_API_KEY חסר; שאר
# המשתנים הם fallback עדין (התכונה שתלויה בהם מסתמנת simulated/כבויה, לא קורסת).

# ---- חובה - חילוץ פרטים/מענה אוטומטי/כל סוכני ה-AI ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- תמלול קולי (Whisper) + חילוץ שדות מהודעה קולית (gpt-4o-mini) ----
# ראו transcription.py - בלעדיו, הודעה קולית נכנסת נרשמת עם טקסט placeholder
# ברור במקום להיעלם, אבל לא מתומללת בפועל.
OPENAI_API_KEY=sk-proj-...

# ---- WhatsApp Provider (ראו whatsapp_provider.py) ----
# twilio (ברירת מחדל) / green_api / ultramsg / mock. שינוי דורש הפעלה מחדש.
WHATSAPP_PROVIDER=ultramsg

# --- Twilio - נדרש תמיד ל-Voice (Click-to-Call), ול-WhatsApp אם WHATSAPP_PROVIDER=twilio ---
# Account SID + Auth Token: Twilio Console, דף הבית.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# מספר ה-WhatsApp (Sandbox או production) - Twilio Console > Messaging > Senders.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# מספר Twilio Voice-capable (לא WhatsApp) - נדרש רק ל-Click-to-Call (voice_call.py).
# בלעדיו, "📞 שיחה" בדשבורד מסתמן simulated_no_config במקום לחייג בפועל.
TWILIO_VOICE_FROM=
# מספר הטלפון של הנציג - הרגל הראשונה של גשר ה-Voice (Twilio מתקשר לכאן קודם).
AGENT_PHONE_NUMBER=
# כתובת ה-URL הציבורית של השרת (ngrok בפיתוח / דומיין אמיתי ב-production),
# בלי / בסוף - Twilio קורא לכתובת הזו (PUBLIC_BASE_URL/voice/connect וכו')
# בתור TwiML webhook. נדרש גם ל-Click-to-Call וגם לאימות webhook הודעות טקסט.
PUBLIC_BASE_URL=

# --- Green API - אלטרנטיבה ל-Twilio ל-WhatsApp (ראו whatsapp_provider.py) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# אופציונלי - דריסה מפורשת של ה-host (ברירת מחדל: מחושב מ-instance ID).
GREEN_API_URL=

# --- UltraMsg - אלטרנטיבה נוספת ל-WhatsApp (ראו whatsapp_provider.py) ---
# מלוח הבקרה: https://ultramsg.com
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# אופציונלי - כמעט אף פעם לא נדרש דריסה (ברירת המחדל היא https://api.ultramsg.com).
ULTRAMSG_URL=

# ---- אבטחת API (שלב 6) ----
# מפתח חובה לכל בקשת /api/* (X-API-Key: <key> או Authorization: Bearer <key>) -
# GET / (הדשבורד) ו-/webhook*//voice/* (מאומתים בנפרד מול Twilio/UltraMsg) פטורים.
# בלעדיו, השרת חוסם fail-closed את כל /api/* (401) - לא פותח את השער בשקט.
# ה-UI (index.html) מקבל את אותו ערך אוטומטית מהשרת - אין להזין אותו שם ידנית.
# צרו ערך חדש וייחודי לכל סביבה, למשל: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=

# ---- הגדרות שרת ----
PORT=5000
# 127.0.0.1 בהרצה מקומית; 0.0.0.0 חובה בתוך קונטיינר/מאחורי load balancer
# (אחרת השרת לא נגיש מחוץ לקונטיינר עצמו).
HOST=0.0.0.0
# production: false תמיד (Flask debug mode חושף Werkzeug debugger שמריץ קוד שרירותי).
FLASK_DEBUG=false
LOG_LEVEL=INFO
# מאמת X-Twilio-Signature על /webhook (form-encoded) - להשאיר true תמיד ב-
# production; false רק לבדיקות ידניות מקומיות בלי חתימת Twilio אמיתית.
VERIFY_TWILIO_SIGNATURE=true

# ---- מצב צל גלובלי (Dry Run - שלב 6, סגירת פיילוט) ----
# false (ברירת מחדל, לא משנה התנהגות קיימת): הודעות יוצאות נשלחות באמת.
# true: כל שליחה יוצאת (מענה אוטומטי/reactivate.py/outbound_engine.py) הופכת
# לסימולציה בלבד (whatsapp_provider.DryRunProviderProxy) - שום הודעת WhatsApp
# אמיתית לא יוצאת ללקוח, אבל webhooks נכנסים אמיתיים ממשיכים להתקבל/להתעבד
# כרגיל (בניגוד ל-WHATSAPP_PROVIDER=mock, שמחליף גם את הקבלה). מעבר מהיר בין
# מצב בדיקה בטוח למצב אמיתי לפני/אחרי פיילוט - בלי לשנות WHATSAPP_PROVIDER.
# דורש הפעלה מחדש של השרת (כמו כל משתנה סביבה אחר כאן).
DRY_RUN=false

# ---- מסד נתונים (שלב 4 - Cloud Production Ready, ראו db.py) ----
# לא מוגדר (ברירת המחדל, גם בהרצה מקומית וגם ב-docker-compose.yml הרגיל) =
# sqlite, קובץ יחיד תחת DATA_DIR - אותה התנהגות בדיוק כמו תמיד. מוגדר
# (postgres://... / postgresql://...) = מתחברים ל-PostgreSQL במקומו - לשימוש
# בענן (Render/Supabase/RDS מנוהלים, או docker-compose --profile postgres
# לבדיקה מקומית - ראו docker-compose.yml). customers.json (מקור האמת ללידים)
# **תמיד** נשאר קובץ נפרד תחת DATA_DIR - לא מושפע מ-DATABASE_URL בכלל.
# DATABASE_URL=postgresql://crm:crm@db:5432/crm_data
# גודל ה-connection pool ל-Postgres בלבד (מתעלם לגמרי אם DATABASE_URL לא מוגדר).
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# ---- הגבלת קצב (Rate Limiting - שלב 4, ראו server.py) ----
# ברירת מחדל: memory:// - מונה בתוך-process; תחת Gunicorn מרובה-workers כל
# process סופר בנפרד (אותו טרייד-אוף כמו SSE/תור ה-webhook - ראו server.py).
# ל-production מרובה-workers/instances אמיתי: redis://<host>:6379/0 (דורש גם
# `pip install redis`) כדי שכל ה-workers ישתפו מונה אחד אמיתי.
# RATELIMIT_STORAGE_URI=memory://
# מכסה גלובלית ברירת מחדל לכל נתיב, ומכסה מחמירה יותר ספציפית ל-/webhook (הנתיב
# החשוף ביותר - חלק מהספקים סומכים רק על סודיות ה-URL, לא על מפתח API).
# RATELIMIT_DEFAULT=200 per minute
# RATELIMIT_WEBHOOK=60 per minute

# ---- השהיה לפני מענה AI אוטומטי (שלב 5 - Enterprise Production Readiness) ----
# אנטי-זיהוי-אוטומציה: תשובה שחוזרת ללקוח תוך שניות בודדות "נראית" בוט מובהק.
# חל רק על ספקים בלי TwiML (UltraMsg/Green API/Mock - ראו server.py) - ל-Twilio
# התשובה חייבת להיכלל בגוף תגובת ה-webhook עצמה, אין אפשרות להשהות שם.
# AUTO_REPLY_MIN_DELAY_SECONDS=35
# AUTO_REPLY_MAX_DELAY_SECONDS=75

# ---- נתיב נתונים קבוע (ראו paths.py) ----
# customers.json/crm_data.db/chat_history.txt נשמרים כאן. ברירת המחדל (לא
# מוגדר בכלל) = תיקיית הפרויקט - מתאים להרצה מקומית בלבד. ב-Docker/Render עם
# ephemeral filesystem, **חובה** להצביע לתיקיית volume קבוע (docker-compose.yml
# כאן כבר מגדיר DATA_DIR=/data אוטומטית - אין צורך לשכפל את זה כאן ב-.env
# בהרצת Docker; רלוונטי בעיקר להרצה ישירה על שרת/VM בלי Docker).
# DATA_DIR=/data

# ---- מנוע התזמון האוטומטי (scheduler.py/scheduler_worker.py) ----
# כל כמה שניות סורקים לידים קרים (ברירת מחדל: 3600 = שעה).
SCHEDULER_INTERVAL_SECONDS=3600
# ⚠️ true = שליחת הודעות WhatsApp אמיתיות אוטומטית, בלי אישור נקודתי לכל הודעה.
# קראו את האזהרה בראש scheduler.py לפני שמפעילים ב-production.
SCHEDULER_AUTO_SEND=false
# ⚠️ אותה אזהרה, עבור הודעות פולו-אפ אוטומטיות ("נוצר קשר" בלי תשובה תוך X שעות).
SCHEDULER_AUTO_FOLLOWUP=false
FOLLOWUP_HOURS=24
# מרווח בדיקת הפולו-אפים ב-clock process (שונה ממרווח סריקת ההחייאה למעלה -
# חלון הפולו-אפ נמדד בשעות, לא בימים).
FOLLOWUP_INTERVAL_SECONDS=1800

# ---- בדיקות בלבד ----
# true = send_whatsapp_message לא פונה ל-Twilio בכלל (MockMessenger) - לבדיקות
# הרמטיות בלי תלות בחשבון Twilio אמיתי. לא קשור ל-SCHEDULER_AUTO_SEND.
# TESTING=false
