    "בטיפול": "contacted", "נוצר קשר": "contacted", "בתהליך": "contacted", "in progress": "contacted", "contacted": "contacted",
    "במעקב": "follow_up", "פולו אפ": "follow_up", "לחזור": "follow_up", "חזרה": "follow_up", "follow up": "follow_up",
    "חם": "hot", "ליד חם": "hot", "מתעניין": "hot", "תואמה פגישה": "hot", "פגישה": "hot", "משא ומתן": "hot", "מו\"מ": "hot",
    "לא רלוונטי": "not_relevant", "לא מעוניין": "not_relevant", "סגור - לא רלוונטי": "not_relevant", "lost": "not_relevant",
